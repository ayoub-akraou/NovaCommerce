{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: up (build)",
      "type": "shell",
      "command": "docker compose up -d --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: down",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: logs",
      "type": "shell",
      "command": "docker compose logs -f",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: prisma studio",
      "type": "shell",
      "command": "docker compose exec backend npx prisma studio --hostname 0.0.0.0 --port 5555 --browser none",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run all: docker + studio",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Docker: up (build)",
        "Docker: prisma studio"
      ],
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend: dev",
      "type": "npm",
      "script": "start:dev",
      "path": "backend",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend: prisma studio",
      "type": "shell",
      "command": "npx prisma studio",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run all: frontend + backend + studio",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Frontend: dev",
        "Backend: dev",
        "Backend: prisma studio"
      ],
      "problemMatcher": []
    }
  ]
}
